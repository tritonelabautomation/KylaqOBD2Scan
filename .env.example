# Environment Variables for KylaqOBD2Scan
# Copy this file to .env and fill in your actual values.

# =============================================================================
# GEMINI API KEY
# =============================================================================
# Required for AI Doctor (Gemini-powered diagnostic assistant).
# Get your key at: https://aistudio.google.com/apikey
# IMPORTANT: This key is compiled into the APK as a string literal.
#   - Research/dev builds: fine — extractable but acceptable for personal use.
#   - Production: you MUST restrict the key in Google Cloud Console with
#     Android app package name + SHA-1 of your signing certificate, or
#     move the Gemini call to a backend proxy server.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# =============================================================================
# GOOGLE WEB CLIENT ID (OAuth for Google Sign-In / Drive backup)
# =============================================================================
# Required for Google Sign-In via AndroidX Credential Manager.
# Get your Web Client ID from:
#   https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#   Create a "Web application" type client, then add Android package + SHA-1.
# Configure in: app/src/main/res/values/strings.xml as 'google_web_client_id'
# Until configured, Google Sign-In is DISABLED.
# GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
