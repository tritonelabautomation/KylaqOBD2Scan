<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- FIX MED-1: obd_research_logger.db and recordings/ can be very large (tens of MB+),
         causing Auto Backup timeouts and excessive Google Drive storage. Exclude them.
         Only lightweight shared preferences (user settings, profiles) are backed up. -->
    <exclude domain="database" path="obd_research_logger.db"/>
    <exclude domain="file" path="recordings"/>
    <include domain="sharedpref" path="."/>
</full-backup-content>
