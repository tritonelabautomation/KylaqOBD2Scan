<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- FIX MED-1: Exclude large data from cloud backup to prevent timeouts and
             excessive storage usage. Only shared preferences (user settings, profiles)
             are included in cloud backup. -->
        <exclude domain="database" path="obd_research_logger.db" />
        <exclude domain="file" path="recordings" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer: include everything (local only, no cloud impact). -->
        <include domain="database" path="obd_research_logger.db" />
        <include domain="file" path="recordings" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
